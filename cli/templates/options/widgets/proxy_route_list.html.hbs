{{! proxyRouteList: attrsOf str, public domain → plain-http upstream (e.g. swag.proxyPass).
    Each entry is a route card: https://domain → TLS ends at the proxy → http://upstream.
    Rows live in uiState (proxy_route_list.js, prl* mixins) and commit to values on edit;
    rows with errors block save via widget.validate. See nix/lib/ui.nix. }}
<div class="mt-2 space-y-3" data-prl="{{name}}">
  <template x-for="(row, idx) in prlRows('{{name}}')" :key="row.id">
    <div class="rounded-xl border bg-base-100/70 shadow-sm overflow-hidden transition-colors"
         :class="{
           'border-error/60': prlRowStatus('{{name}}', row.id) === 'error',
           'border-warning/60': prlRowStatus('{{name}}', row.id) === 'warning',
           'border-success/40': prlRowStatus('{{name}}', row.id) === 'ok',
           'border-base-300 border-dashed': prlRowStatus('{{name}}', row.id) === ''
         }">

      {{! Header: route number, status, remove }}
      <div class="flex items-center justify-between gap-2 px-3 sm:px-4 pt-2.5">
        <div class="flex items-center gap-2 min-w-0">
          <span class="text-[10px] uppercase tracking-wide font-semibold text-base-content/45"
                x-text="prlEntryLabel('{{name}}') + ' ' + (idx + 1)"></span>
          <span class="badge badge-xs"
                :class="{
                  'badge-error': prlRowStatus('{{name}}', row.id) === 'error',
                  'badge-warning': prlRowStatus('{{name}}', row.id) === 'warning',
                  'badge-success badge-outline': prlRowStatus('{{name}}', row.id) === 'ok',
                  'badge-ghost': prlRowStatus('{{name}}', row.id) === ''
                }"
                x-text="prlRowStatusLabel('{{name}}', row.id)"></span>
        </div>
        <button type="button"
                class="btn btn-ghost btn-xs text-error shrink-0"
                @click="prlRemove('{{name}}', row.id)"
                :aria-label="'Remove route ' + (idx + 1)"
                title="Remove this route">Remove</button>
      </div>

      {{! Flow: visitor → proxy (TLS) → backend }}
      <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-stretch gap-2 md:gap-3 px-3 sm:px-4 py-3">
        <label class="flex flex-col gap-1 min-w-0">
          <span class="flex items-center gap-1.5 text-xs font-medium text-base-content/70">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5 text-primary shrink-0" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM4.332 8.027a6.012 6.012 0 011.912-2.706C6.512 5.73 6.974 6 7.5 6A1.5 1.5 0 019 7.5V8a2 2 0 004 0 2 2 0 011.523-1.943A5.977 5.977 0 0116 10c0 .34-.028.675-.083 1H15a2 2 0 00-2 2v2.197A5.973 5.973 0 0110 16v-2a2 2 0 00-2-2 2 2 0 01-2-2 2 2 0 00-1.668-1.973z" clip-rule="evenodd"/></svg>
            Public domain
          </span>
          <div class="join w-full">
            <span class="join-item inline-flex items-center px-2 border border-base-300 bg-base-200 text-base-content/55 font-mono text-xs select-none">https://</span>
            <input type="text"
                   class="input input-sm join-item flex-1 min-w-0 font-mono"
                   :class="{
                     'input-error': prlFieldLevel('{{name}}', row.id, 'domain') === 'error',
                     'input-warning': prlFieldLevel('{{name}}', row.id, 'domain') === 'warning'
                   }"
                   data-prl-domain
                   :value="row.domain"
                   @input="prlSet('{{name}}', row.id, 'domain', $event.target.value)"
                   placeholder="octo.example.com"
                   spellcheck="false" autocomplete="off" autocapitalize="off"
                   :aria-invalid="prlFieldLevel('{{name}}', row.id, 'domain') === 'error'">
          </div>
        </label>

        <div class="flex md:flex-col items-center justify-center gap-1.5 md:pt-5 text-base-content/40"
             aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 rotate-90 md:rotate-0"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/></svg>
          <span class="badge badge-sm badge-success badge-outline gap-1 whitespace-nowrap"
                title="Visitors connect over https. SWAG holds the Let's Encrypt certificate for this domain, decrypts the request and forwards it to the upstream.">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd"/></svg>
            TLS ends at SWAG
          </span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 rotate-90 md:rotate-0"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/></svg>
        </div>

        <label class="flex flex-col gap-1 min-w-0">
          <span class="flex items-center gap-1.5 text-xs font-medium text-base-content/70">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5 text-secondary shrink-0" aria-hidden="true"><path d="M4.08 5.227A3 3 0 016.979 3H13.02a3 3 0 012.9 2.227l1.868 7.004A3.013 3.013 0 0016 12H4a3.01 3.01 0 00-1.788.231l1.868-7.004z"/><path fill-rule="evenodd" d="M2 15a2 2 0 012-2h12a2 2 0 110 4H4a2 2 0 01-2-2zm12.5 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0zM12 15.75a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd"/></svg>
            Upstream (plain http on your network)
          </span>
          <input type="text"
                 class="input input-sm w-full font-mono"
                 :class="{
                   'input-error': prlFieldLevel('{{name}}', row.id, 'upstream') === 'error',
                   'input-warning': prlFieldLevel('{{name}}', row.id, 'upstream') === 'warning'
                 }"
                 :value="row.upstream"
                 @input="prlSet('{{name}}', row.id, 'upstream', $event.target.value)"
                 placeholder="http://192.168.1.20:8123"
                 spellcheck="false" autocomplete="off" autocapitalize="off"
                 :aria-invalid="prlFieldLevel('{{name}}', row.id, 'upstream') === 'error'">
        </label>
      </div>

      {{! Summary strip + inline issues }}
      <div class="border-t border-base-300/70 bg-base-200/40 px-3 sm:px-4 py-2 space-y-1.5"
           x-show="prlRowStatus('{{name}}', row.id) !== ''">
        <div class="flex items-center gap-1.5 min-w-0 font-mono text-[11px] text-base-content/60">
          <span class="truncate" x-text="'https://' + prlShownDomain(row)"></span>
          <span class="shrink-0 text-base-content/35">→</span>
          <span class="truncate" x-text="prlShownUpstream(row)"></span>
        </div>
        <template x-for="(it, i) in prlIssues('{{name}}', row.id)" :key="i">
          <div class="flex items-start gap-2 text-xs leading-snug"
               :class="{
                 'text-error': it.level === 'error',
                 'text-warning': it.level === 'warning',
                 'text-base-content/55': it.level === 'info'
               }">
            <span class="mt-px shrink-0 font-bold" aria-hidden="true"
                  x-text="it.level === 'error' ? '✕' : (it.level === 'warning' ? '!' : 'ⓘ')"></span>
            <div class="flex-1 min-w-0 flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-2">
              <span class="flex-1 min-w-0 break-words">
                <span class="font-semibold" x-text="it.field === 'domain' ? 'Domain:' : 'Upstream:'"></span>
                <span x-text="it.text"></span>
              </span>
              <button type="button"
                      class="btn btn-outline btn-xs h-auto min-h-0 py-0.5 self-start shrink-0 max-w-full font-mono normal-case"
                      x-show="it.fix"
                      @click="prlApplyFix('{{name}}', row.id, it.fix)"
                      :title="'Apply fix: ' + (it.fix ? it.fix.label : '')">
                <span class="truncate" x-text="it.fix ? it.fix.label : ''"></span>
              </button>
            </div>
          </div>
        </template>
      </div>
    </div>
  </template>

  {{! Empty state }}
  <div class="rounded-xl border border-dashed border-base-300 bg-base-200/30 p-4 sm:p-5 text-center space-y-2"
       x-show="prlRows('{{name}}').length === 0">
    <div class="flex items-center justify-center gap-2 font-mono text-xs text-base-content/50" aria-hidden="true">
      <span class="rounded-md border border-base-300 bg-base-100 px-2 py-1">https://app.example.com</span>
      <span>→</span>
      <span class="badge badge-sm badge-success badge-outline">SWAG</span>
      <span>→</span>
      <span class="rounded-md border border-base-300 bg-base-100 px-2 py-1">http://192.168.1.20:8123</span>
    </div>
    <p class="text-sm font-medium">No extra routes yet</p>
    <p class="text-xs text-base-content/60 leading-snug max-w-prose mx-auto" x-text="prlEmptyHint('{{name}}')"></p>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-2">
    <button type="button"
            class="btn btn-outline btn-primary btn-sm"
            @click="prlAdd('{{name}}'); $nextTick(() => { const els = $el.closest('[data-prl]')?.querySelectorAll('[data-prl-domain]') || []; els[els.length - 1]?.focus(); })">
      + Add route
    </button>
    <div class="flex items-center gap-2 text-xs text-base-content/55" x-show="prlRouteCount('{{name}}') > 0">
      <span x-text="prlRouteCount('{{name}}') + (prlRouteCount('{{name}}') === 1 ? ' route' : ' routes')"></span>
      <span class="badge badge-error badge-xs" x-show="prlCount('{{name}}', 'error') > 0"
            x-text="prlCount('{{name}}', 'error') + ' blocking save'"></span>
      <span class="badge badge-warning badge-xs" x-show="prlCount('{{name}}', 'warning') > 0"
            x-text="prlCount('{{name}}', 'warning') + ' to check'"></span>
    </div>
  </div>
  <p class="text-[11px] text-base-content/45 leading-snug" x-show="prlRouteCount('{{name}}') > 0">
    Point each domain's DNS at this server; a certificate is requested for it on the next deploy.
  </p>
</div>
