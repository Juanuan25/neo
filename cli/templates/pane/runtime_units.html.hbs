{{!-- Status tab. Unit rows: live ActiveState + controls are pushed over /ws/status
     after the configuration page registers these units (watch_replace on
     .unit-row[data-unit]). Clear appdata sits apart in a danger zone. --}}
<div id="runtime-units" class="space-y-5"{{#if units}} data-units="{{#each units}}{{name}}{{#unless @last}} {{/unless}}{{/each}}"{{/if}}>
  {{#if units}}
    <div>
      <div class="flex items-end justify-between gap-3 flex-wrap mb-2">
        <div class="min-w-0">
          <h3 class="font-semibold text-sm sm:text-base">Running processes</h3>
          <p class="text-xs text-base-content/60">Live state of this service's systemd units.</p>
        </div>
        {{#if group_unit}}
          {{!-- Group target: wraps the member units. systemctl needs the .target suffix. --}}
          <div class="join unit-controls-group rounded-field border border-base-300 bg-base-100">
            <button type="button" class="join-item btn btn-sm btn-ghost gap-1.5 text-success" hx-post="/unit/start/{{group_unit}}" data-neo-lock="unit/{{group_unit}}" hx-swap="none" title="systemctl start {{group_unit}}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path d="M6.3 3.9A1 1 0 004.8 4.8v10.4a1 1 0 001.5.9l8.6-5.2a1 1 0 000-1.8L6.3 3.9z"/></svg>
              <span class="text-base-content">Start all</span>
            </button>
            <button type="button" class="join-item btn btn-sm btn-ghost gap-1.5" hx-post="/unit/restart/{{group_unit}}" data-neo-lock="unit/{{group_unit}}" hx-swap="none" title="systemctl restart {{group_unit}}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M19.5 12a7.5 7.5 0 11-2.2-5.3M19.5 4.5v4h-4"/></svg>
              Restart all
            </button>
            <button type="button" class="join-item btn btn-sm btn-ghost gap-1.5 text-error" hx-post="/unit/stop/{{group_unit}}" data-neo-lock="unit/{{group_unit}}" hx-swap="none" title="systemctl stop {{group_unit}}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true"><rect x="5" y="5" width="10" height="10" rx="1.5"/></svg>
              <span class="text-base-content">Stop all</span>
            </button>
          </div>
        {{/if}}
      </div>
      {{!-- Every row uses the same fixed control slots (see units/control.rs), so
           state pills and buttons line up in columns across rows. --}}
      <ul class="rounded-box border border-base-300 bg-base-100 divide-y divide-base-300/70">
        {{#each units}}
          <li class="unit-row flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 px-3 sm:px-4 py-2.5" data-unit="{{name}}"{{#if is_timer}} data-timer{{/if}}>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 min-w-0">
                <span class="font-mono text-xs sm:text-sm truncate" title="{{name}}">{{name}}</span>
                {{#if is_timer}}<span class="badge badge-ghost badge-xs shrink-0" title="Runs on a schedule; idle between runs">scheduled</span>{{/if}}
                {{#if is_setup}}<span class="badge badge-ghost badge-xs shrink-0" title="Runs once after its containers start and retries until it succeeds; done afterwards">setup</span>{{/if}}
              </div>
              <div id="update-out-{{name}}" class="update-out update-out-inline text-[10px] max-w-full truncate empty:hidden" title=""></div>
            </div>
            <div id="unit-controls-{{name}}" class="unit-controls">
              <span class="neo-unit-state"><span class="neo-unit-dot" data-state="unknown" aria-hidden="true"></span><span class="truncate">checking…</span></span>
            </div>
          </li>
        {{/each}}
      </ul>
    </div>
  {{else}}
    <div class="flex items-center gap-2 rounded-box border border-base-300 bg-base-100 px-3 sm:px-4 py-2.5 text-sm text-base-content/70">
      <span class="neo-unit-dot" data-state="idle" aria-hidden="true"></span>
      Configured · no processes. This service declares no systemd units to watch.
    </div>
  {{/if}}

  {{#if appdata}}
    <div class="rounded-box border border-error/30 bg-error/5 p-3 sm:p-4">
      <h3 class="font-semibold text-sm text-error">Danger zone</h3>
      <div class="mt-2 flex flex-col sm:flex-row sm:items-center gap-3 justify-between">
        <div class="text-xs text-base-content/70 min-w-0">
          <div class="font-medium text-base-content text-sm">Clear app data</div>
          Permanently deletes <span class="font-mono break-all">{{appdata}}</span>{{#if units}}, stopping the service while it runs{{/if}}. This cannot be undone.
        </div>
        <button id="clear-appdata-btn-{{service}}"
                class="btn btn-error btn-outline btn-sm shrink-0"
                title="Delete {{appdata}}"
                hx-post="/service/{{service}}/clear-appdata"
                hx-swap="none"
                hx-confirm="{{#if units}}Stop all related units, permanently delete {{appdata}} and all contents, then start the units again? This cannot be undone.{{else}}Permanently delete {{appdata}} and all contents? This cannot be undone.{{/if}}"
                hx-disabled-elt="this">
          Clear appdata
        </button>
      </div>
      <div id="clear-appdata-out-{{service}}" class="clear-appdata-out text-xs mt-2 flex-shrink-0 max-w-full truncate" title=""></div>
    </div>
  {{/if}}
</div>
