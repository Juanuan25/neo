{{!-- Save / discard controls (sticky strip). --}}
<button type="button"
        @click="revertAll()"
        class="btn btn-sm btn-ghost"
        x-show="saveFlash !== 'ok'"
        :disabled="saveBusy">Discard</button>
<button type="button"
        @click="save()"
        class="btn btn-sm"
        :class="saveFlash === 'ok' ? 'btn-success' : (saveFlash === 'err' ? 'btn-error' : 'btn-primary')"
        :disabled="saveBusy || saveFlash === 'ok'"
        :aria-busy="saveBusy"
        :title="saveFlash === 'err' ? saveError : ''">
  <span x-show="saveBusy" class="loading loading-spinner loading-xs" aria-hidden="true"></span>
  <span x-text="saveBusy ? 'Saving…' : (saveFlash === 'ok' ? 'Saved' : (saveFlash === 'err' ? 'Retry save' : 'Save'))">Save</span>
</button>
