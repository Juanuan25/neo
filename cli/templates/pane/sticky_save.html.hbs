{{!-- Sticky strip: pane tabs on the left, Save/Discard on the right (only while
     there is something to save). Full card width (matches action bar); the glass
     plate fuses with the action bar on scroll (configuration.js). --}}
<div id="options-sticky-save"
     class="sticky z-20 w-full px-3 sm:px-6 bg-base-100/60 backdrop-blur-xs border-y border-base-300/50 py-1.5 sm:py-2 mb-0 flex items-center justify-between gap-2 min-h-12 transition-[background-color,box-shadow,border-color] duration-200"
     style="top: calc(var(--neo-sticky-bar-top, 0.75rem) + var(--neo-action-bar-height, 3.5rem));">
  {{#if (or units appdata)}}
    <div role="tablist" class="tabs tabs-box tabs-sm flex-nowrap min-w-0 overflow-x-auto neo-pane-tabs">
      <button type="button" role="tab" class="tab gap-1.5"
              :class="{ 'tab-active': paneTab === 'settings' }"
              :aria-selected="paneTab === 'settings'"
              @click="setPaneTab('settings')">
        Settings
        <span x-cloak x-show="isDirty()" class="inline-block w-1.5 h-1.5 rounded-full bg-warning" aria-label="unsaved changes"></span>
      </button>
      <button type="button" role="tab" class="tab gap-1.5"
              :class="{ 'tab-active': paneTab === 'status' }"
              :aria-selected="paneTab === 'status'"
              @click="setPaneTab('status')">
        {{#if units}}<span class="neo-unit-dot" data-unit-summary-dot aria-hidden="true"></span>{{/if}}
        Status
      </button>
      {{#if appdata}}
        <button type="button" role="tab" class="tab"
                :class="{ 'tab-active': paneTab === 'snapshots' }"
                :aria-selected="paneTab === 'snapshots'"
                @click="setPaneTab('snapshots')">
          Snapshots
        </button>
      {{/if}}
    </div>
  {{else}}
    <span class="text-sm font-semibold">Settings</span>
  {{/if}}
  {{#if options}}
    <div class="flex items-center gap-2 shrink-0"
         x-cloak
         x-show="isDirty() || saveBusy || saveFlash"
         x-transition.opacity>
      <span class="badge badge-warning badge-sm hidden md:inline-flex"
            x-show="isDirty() && !saveBusy && saveFlash !== 'ok'">
        <span x-text="dirtyCount()"></span>&nbsp;unsaved
      </span>
      {{> pane/save_actions}}
    </div>
  {{/if}}
</div>
