{{!-- System resources widget: compact CPU/RAM/disk strip, expands to a
     btop-inspired detail view (per-core CPU, memory incl. ZFS ARC as its own
     segment, swap, disks/pools, network, top processes). Fully client
     driven — see static/resources_panel.js (GET /resources/snapshot polling,
     paused while collapsed/hidden). No server-rendered data needed here. --}}
<div class="rounded-box border border-base-300 bg-base-100 mb-4"
     x-data="resourcesPanel()"
     data-neo-progress="false">
  <button type="button"
          class="w-full flex items-center gap-3 sm:gap-4 p-2.5 sm:p-3 text-left cursor-pointer"
          @click="toggle()"
          :aria-expanded="expanded.toString()"
          title="System resources">
    <span class="shrink-0 w-8 h-8 rounded-lg bg-base-200 flex items-center justify-center text-base-content/60">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><path d="M7 7.5h.01M7 16.5h.01"/></svg>
    </span>

    <span class="flex-1 min-w-0 grid grid-cols-3 gap-2 sm:gap-4">
      <span class="min-w-0">
        <span class="flex items-center justify-between text-[11px] text-base-content/60 mb-0.5">
          <span>CPU</span>
          <span class="tabular-nums" x-text="Math.round(cpuPct()) + '%'"></span>
        </span>
        <progress class="progress w-full h-1.5" :class="'progress-' + tone(cpuPct())" :value="cpuPct()" max="100"></progress>
      </span>
      <span class="min-w-0">
        <span class="flex items-center justify-between text-[11px] text-base-content/60 mb-0.5">
          <span>RAM</span>
          <span class="tabular-nums" x-text="Math.round(memPct()) + '%'"></span>
        </span>
        <progress class="progress w-full h-1.5" :class="'progress-' + tone(memPct())" :value="memPct()" max="100"></progress>
      </span>
      <span class="min-w-0">
        <span class="flex items-center justify-between text-[11px] text-base-content/60 mb-0.5">
          <span>Disk</span>
          <span class="tabular-nums" x-text="Math.round(rootDiskPct()) + '%'"></span>
        </span>
        <progress class="progress w-full h-1.5" :class="'progress-' + tone(rootDiskPct())" :value="rootDiskPct()" max="100"></progress>
      </span>
    </span>

    <span class="hidden md:inline text-[11px] text-base-content/50 shrink-0 font-mono" x-text="snap ? fmtUptime(snap.uptime_secs) + ' up' : ''"></span>

    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 shrink-0 text-base-content/40 transition-transform" :class="{ 'rotate-180': expanded }" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
  </button>

  <p class="px-3 pb-2 -mt-1 text-[11px] text-error" x-show="errorMsg" x-text="errorMsg" x-cloak></p>

  <div class="border-t border-base-300 p-3 sm:p-4 space-y-4" x-show="expanded" x-cloak>
    <div x-show="loading" class="flex justify-center py-6">
      <span class="loading loading-spinner loading-sm opacity-50"></span>
    </div>

    <template x-if="snap && !loading">
      <div class="space-y-4">
        <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-base-content/60">
          <span>Load <span class="font-mono" x-text="loadText()"></span></span>
          <span>Uptime <span class="font-mono" x-text="fmtUptime(snap.uptime_secs)"></span></span>
          <span>Net
            <span class="font-mono">&darr;<span x-text="fmtRate(snap.net.rx_bytes_per_sec)"></span></span>
            <span class="font-mono">&uarr;<span x-text="fmtRate(snap.net.tx_bytes_per_sec)"></span></span>
          </span>
        </div>

        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-1.5">
            CPU <span class="normal-case font-normal text-base-content/40" x-text="'· ' + Math.round(cpuPct()) + '% overall · ' + snap.cpu.per_core_pct.length + ' cores'"></span>
          </h4>
          <div class="grid grid-cols-4 sm:grid-cols-6 lg:grid-cols-8 gap-1.5">
            <template x-for="(pct, idx) in snap.cpu.per_core_pct" :key="idx">
              <div class="min-w-0">
                <div class="flex items-center justify-between text-[10px] text-base-content/50">
                  <span x-text="idx"></span><span class="tabular-nums" x-text="Math.round(pct) + '%'"></span>
                </div>
                <progress class="progress w-full h-1" :class="'progress-' + tone(pct)" :value="pct" max="100"></progress>
              </div>
            </template>
          </div>
        </div>

        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-1.5">Memory</h4>
          <div class="h-3 w-full rounded-full overflow-hidden flex bg-base-200" role="img" aria-label="Memory breakdown">
            <div class="bg-primary h-full" :style="'width:' + memShare(snap.mem.used_bytes) + '%'"></div>
            <div class="bg-info/70 h-full" :style="'width:' + memShare(snap.mem.cache_bytes) + '%'"></div>
            <div class="bg-secondary h-full" x-show="snap.mem.arc_bytes !== null" :style="'width:' + memShare(snap.mem.arc_bytes) + '%'"></div>
          </div>
          <div class="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-base-content/60">
            <span class="inline-flex items-center gap-1"><i class="inline-block w-2 h-2 rounded-full bg-primary"></i>Used <span class="font-mono" x-text="fmtBytes(snap.mem.used_bytes)"></span></span>
            <span class="inline-flex items-center gap-1"><i class="inline-block w-2 h-2 rounded-full bg-info/70"></i>Cache <span class="font-mono" x-text="fmtBytes(snap.mem.cache_bytes)"></span></span>
            <span class="inline-flex items-center gap-1" x-show="snap.mem.arc_bytes !== null" title="ZFS caches recently used data here; it shrinks automatically when other programs need RAM.">
              <i class="inline-block w-2 h-2 rounded-full bg-secondary"></i>ZFS ARC <span class="font-mono" x-text="fmtBytes(snap.mem.arc_bytes)"></span>
            </span>
            <span class="inline-flex items-center gap-1"><i class="inline-block w-2 h-2 rounded-full bg-base-300"></i>Free <span class="font-mono" x-text="fmtBytes(snap.mem.free_bytes)"></span></span>
            <span x-show="snap.mem.swap_total_bytes > 0">Swap <span class="font-mono" x-text="fmtBytes(snap.mem.swap_used_bytes) + ' / ' + fmtBytes(snap.mem.swap_total_bytes)"></span></span>
            <span class="ml-auto font-mono">Total <span x-text="fmtBytes(snap.mem.total_bytes)"></span></span>
          </div>
        </div>

        <div x-show="snap.disks.length">
          <h4 class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-1.5">Disks</h4>
          <div class="space-y-1.5">
            <template x-for="d in snap.disks" :key="d.mount">
              <div>
                <div class="flex items-center justify-between text-[11px] text-base-content/60 gap-2">
                  <span class="font-mono truncate flex items-center gap-1.5 min-w-0">
                    <span class="truncate" x-text="d.mount"></span>
                    <span class="badge badge-ghost badge-xs shrink-0" x-show="d.is_zfs">zfs</span>
                  </span>
                  <span class="tabular-nums shrink-0" x-text="fmtBytes(d.used_bytes) + ' / ' + fmtBytes(d.total_bytes)"></span>
                </div>
                <progress class="progress w-full h-1.5" :class="'progress-' + tone(diskPct(d))" :value="diskPct(d)" max="100"></progress>
              </div>
            </template>
          </div>
        </div>

        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-1.5">Top processes</h4>
          <div class="overflow-x-auto rounded-field border border-base-300">
            <table class="table table-xs">
              <thead>
                <tr>
                  <th class="cursor-pointer select-none" @click="setSort('pid')">PID</th>
                  <th class="cursor-pointer select-none" @click="setSort('name')">Process</th>
                  <th class="cursor-pointer select-none text-right" @click="setSort('cpu_pct')">CPU %</th>
                  <th class="cursor-pointer select-none text-right" @click="setSort('mem_bytes')">Mem</th>
                </tr>
              </thead>
              <tbody>
                <template x-for="p in sortedProcs()" :key="p.pid">
                  <tr>
                    <td class="font-mono text-base-content/50" x-text="p.pid"></td>
                    <td class="font-mono truncate max-w-[14rem] sm:max-w-[20rem]" :title="p.name" x-text="p.name"></td>
                    <td class="text-right tabular-nums" x-text="p.cpu_pct.toFixed(1)"></td>
                    <td class="text-right tabular-nums" x-text="fmtBytes(p.mem_bytes)"></td>
                  </tr>
                </template>
                <tr x-show="!sortedProcs().length">
                  <td colspan="4" class="text-center text-base-content/40 py-3">No process data yet</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </template>
  </div>
</div>
